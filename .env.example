# Copy to `.env.local` and fill in your Supabase project values.
# Both values are safe to expose in the browser (the anon key is protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Hostinger mailbox password for info@crownlegacydobermans.com — sends the
# admin notification email for every form submission (contact, puppy
# application, contract, newsletter). Server-only, never exposed to the
# browser. Host/port/address are fixed in code (smtp.hostinger.com:465,
# same address as site.email) — this is the only value that changes.
SMTP_PASS=your-mailbox-password
