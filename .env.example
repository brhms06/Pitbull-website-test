# Copy to `.env.local` and fill in your Supabase project values.
# Both values are safe to expose in the browser (the anon key is protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Web3Forms — emails contact/application/order form submissions to your inbox.
# Get a free key at https://web3forms.com (it is safe to expose in the browser).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
